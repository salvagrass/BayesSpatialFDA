chol_factor <- if (is.null(chol_factor)) {
Matrix::Cholesky(Q_post, LDL = FALSE)
} else {
tryCatch(
Matrix::update(chol_factor, Q_post),
error = function(e) Matrix::Cholesky(Q_post, LDL = FALSE)
)
}
b_post <- PtY / sigma2 + as.vector(Q %*% mu)
post_mean <- as.matrix(Matrix::solve(chol_factor, b_post, system = "A"))
# Q_post = P' L L' P  =>  P' L'^-1 z ~ N(0, Q_post^-1)
z <- matrix(rnorm(V * M), nrow = V, ncol = M)
deviation <- Matrix::solve(
chol_factor,
Matrix::solve(chol_factor, z, system = "Lt"),
system = "Pt"
)
beta_samples[, , s] <- post_mean + as.matrix(deviation)
mu_samples[, s] <- mu
if (verbose) setTxtProgressBar(pb, s)
}
list(
hyper = hyper,
beta_samples = beta_samples,
mu_samples = mu_samples,
draw_chain = draw_chain,
draw_iter = draw_iter,
acceptance_rate = vapply(
fit,
function(chain) mean(utils::tail(chain$theta_accept, num_saved)),
numeric(1)
)
)
}
#' Posterior Summaries of the Anomaly Field beta_tilde = beta - mu
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @return List with `mean` and `sd` (V x M matrices)
summarize_anomaly <- function(res) {
dims <- dim(res$beta_samples)
V <- dims[1]
M <- dims[2]
anomaly_mean <- matrix(NA_real_, V, M)
anomaly_sd <- matrix(NA_real_, V, M)
for (t in seq_len(M)) {
draws_t <- res$beta_samples[, t, ] - res$mu_samples
anomaly_mean[, t] <- rowMeans(draws_t)
anomaly_sd[, t] <- apply(draws_t, 1, sd)
}
list(mean = anomaly_mean, sd = anomaly_sd)
}
#' True Anomaly Field at the Mesh Vertices
#'
#' @param sim_data Output list of the toy data generator
#' @return V x M matrix beta - mu
get_true_anomaly <- function(sim_data) {
sim_data$beta_mat - sim_data$mu_true
}
#' Common ggplot2 Theme for the Diagnostic Plots
#'
#' @param base_size Base font size
diag_theme <- function(base_size = 11) {
ggplot2::theme_bw(base_size = base_size) +
ggplot2::theme(
plot.title = ggplot2::element_text(face = "bold"),
strip.text = ggplot2::element_text(face = "bold"),
strip.background = ggplot2::element_rect(fill = "grey92", colour = NA),
panel.grid.minor = ggplot2::element_blank()
)
}
#' Plot MCMC Traces by Chain with Ground Truth (ggplot2)
#'
#' The C++ sampler does not record the burn-in, so the traces start at
#' `num_burn_in + 1`. The hyperparameters are shown at every iteration;
#' beta_tilde[vertex, 1] only at the iterations where mu was saved.
#' Chains that overlap and wander around the same values are a sign of
#' convergence; a chain stuck in a different region is not.
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @param sim_data Output list of the toy data generator
#' @param truth List of true values (kappa, sigma_beta, v1, v2, sigma_e)
#' @param num_burn_in Number of burn-in iterations
#' @param vertex Vertex index used for the beta_tilde trace
#' @return Invisibly returns the ggplot object (it is also printed)
plot_mcmc_traces <- function(res, sim_data, truth, num_burn_in, vertex = 1L) {
hyper_names <- colnames(res$hyper[[1]])
beta_label <- sprintf("beta_tilde[%d,1]", vertex)
param_levels <- c(hyper_names, beta_label)
hyper_df <- do.call(rbind, lapply(seq_along(res$hyper), function(c) {
draws <- res$hyper[[c]]
data.frame(
chain = c,
iteration = num_burn_in + rep(seq_len(nrow(draws)), times = ncol(draws)),
parameter = rep(hyper_names, each = nrow(draws)),
value = as.vector(draws)
)
}))
beta_df <- data.frame(
chain = res$draw_chain,
iteration = res$draw_iter,
parameter = beta_label,
value = res$beta_samples[vertex, 1, ] - res$mu_samples[vertex, ]
)
trace_df <- rbind(hyper_df, beta_df)
trace_df$parameter <- factor(trace_df$parameter, levels = param_levels)
trace_df$chain <- factor(trace_df$chain)
truth_df <- data.frame(
parameter = factor(param_levels, levels = param_levels),
true = c(
truth$sigma_e^2, truth$kappa, truth$sigma_beta, truth$v1, truth$v2,
get_true_anomaly(sim_data)[vertex, 1]
)
)
p <- ggplot2::ggplot(trace_df, ggplot2::aes(x = iteration, y = value, colour = chain)) +
ggplot2::geom_line(linewidth = 0.25, alpha = 0.8) +
ggplot2::geom_hline(
data = truth_df,
ggplot2::aes(yintercept = true),
colour = "firebrick",
linewidth = 0.8
) +
ggplot2::facet_wrap(~parameter, scales = "free_y", ncol = 3) +
ggplot2::scale_colour_brewer(palette = "Dark2") +
ggplot2::labs(
title = "MCMC traces (post burn-in)",
subtitle = "Red: true value | beta_tilde only at the iterations where mu was saved",
x = "Iteration",
y = NULL,
colour = "Chain"
) +
diag_theme()
print(p)
invisible(p)
}
#' Post Burn-In Hyperparameter Draws on the Scale of the Metropolis Step
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @return coda::mcmc.list with log sigma^2_e, log kappa, log sigma_beta, v1, v2
get_hyper_mcmc <- function(res) {
coda::mcmc.list(lapply(res$hyper, function(draws) {
coda::mcmc(cbind(
"log sigma^2_e" = log(draws[, "sigma^2_e"]),
"log kappa" = log(draws[, "kappa"]),
"log sigma_beta" = log(draws[, "sigma_beta"]),
"v1" = draws[, "v1"],
"v2" = draws[, "v2"]
))
}))
}
#' Plot ACF by Chain (ggplot2), Effective Sample Size and R-hat
#'
#' ESS is summed over the chains (coda::effectiveSize). R-hat is the
#' Gelman-Rubin potential scale reduction factor (coda::gelman.diag): it compares
#' the variance between chains with the variance within chains, and values close
#' to 1 (below about 1.01-1.05) indicate that the chains agree. beta_tilde is
#' only available at the iterations where mu was saved, so it appears in the
#' table but not in the ACF plot (its lags would be in different units).
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @param lag_max Maximum lag for ACF plots
#' @param vertex Vertex index used for beta_tilde[vertex, 1]
#' @return Data frame with ESS, number of draws and R-hat
plot_mcmc_acf_ess <- function(res, lag_max = 60L, vertex = 1L) {
hyper_mcmc <- get_hyper_mcmc(res)
param_names <- coda::varnames(hyper_mcmc)
acf_df <- do.call(rbind, lapply(seq_along(hyper_mcmc), function(c) {
do.call(rbind, lapply(param_names, function(nm) {
a <- stats::acf(as.vector(hyper_mcmc[[c]][, nm]), lag.max = lag_max, plot = FALSE)
data.frame(chain = c, parameter = nm, lag = as.vector(a$lag), acf = as.vector(a$acf))
}))
}))
acf_df$parameter <- factor(acf_df$parameter, levels = param_names)
acf_df$chain <- factor(acf_df$chain)
conf_band <- stats::qnorm(0.975) / sqrt(coda::niter(hyper_mcmc))
p <- ggplot2::ggplot(acf_df, ggplot2::aes(x = lag, y = acf, colour = chain)) +
ggplot2::geom_hline(yintercept = 0, colour = "grey40") +
ggplot2::geom_hline(
yintercept = c(-conf_band, conf_band),
linetype = "dashed",
colour = "steelblue"
) +
ggplot2::geom_line(linewidth = 0.5) +
ggplot2::facet_wrap(~parameter, ncol = 3) +
ggplot2::scale_colour_brewer(palette = "Dark2") +
ggplot2::coord_cartesian(ylim = c(min(-0.2, min(acf_df$acf)), 1)) +
ggplot2::labs(
title = "Autocorrelation by chain (post burn-in)",
subtitle = "Dashed blue: 95% band for zero autocorrelation",
x = "Lag",
y = "ACF",
colour = "Chain"
) +
diag_theme()
print(p)
beta_draws <- res$beta_samples[vertex, 1, ] - res$mu_samples[vertex, ]
beta_mcmc <- coda::mcmc.list(lapply(
split(beta_draws, res$draw_chain),
coda::mcmc
))
rhat <- function(x) coda::gelman.diag(x, autoburnin = FALSE, multivariate = FALSE)$psrf[, 1]
data.frame(
Parameter = c(param_names, sprintf("beta_tilde[%d,1]", vertex)),
ESS = round(c(coda::effectiveSize(hyper_mcmc), coda::effectiveSize(beta_mcmc))),
Out_of = c(
rep(coda::niter(hyper_mcmc) * coda::nchain(hyper_mcmc), length(param_names)),
length(beta_draws)
),
Rhat = round(c(rhat(hyper_mcmc), rhat(beta_mcmc)), 3),
row.names = NULL
)
}
#' Plot the Gelman-Rubin Statistic as the Chains Grow (ggplot2)
#'
#' R-hat (coda::gelman.diag, without the multivariate version) is recomputed on
#' the first n post burn-in draws of every chain, for increasing n. It should
#' decrease towards 1 and stay there: R-hat compares the variance between
#' chains with the variance within chains, so values above 1 mean the chains
#' have not yet reached the same distribution. The dashed line marks 1.01, the
#' threshold recommended by Vehtari et al. (2021).
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @param num_burn_in Number of burn-in iterations
#' @param n_points Number of chain lengths at which R-hat is computed
#' @return Invisibly returns the ggplot object (it is also printed)
plot_gelman_rubin <- function(res, num_burn_in, n_points = 50L) {
hyper_mcmc <- get_hyper_mcmc(res)
n_iter <- coda::niter(hyper_mcmc)
ends <- unique(round(seq(50, n_iter, length.out = n_points)))
rhat_df <- do.call(rbind, lapply(ends, function(n) {
psrf <- coda::gelman.diag(
window(hyper_mcmc, end = n),
autoburnin = FALSE,
multivariate = FALSE
)$psrf
data.frame(iteration = num_burn_in + n, parameter = rownames(psrf), rhat = psrf[, 1])
}))
rhat_df$parameter <- factor(rhat_df$parameter, levels = coda::varnames(hyper_mcmc))
p <- ggplot2::ggplot(rhat_df, ggplot2::aes(x = iteration, y = rhat)) +
ggplot2::geom_hline(yintercept = 1, colour = "grey40") +
ggplot2::geom_hline(yintercept = 1.01, linetype = "dashed", colour = "steelblue") +
ggplot2::geom_line(linewidth = 0.5) +
ggplot2::geom_point(size = 0.8) +
ggplot2::facet_wrap(~parameter, ncol = 3, scales = "free_y") +
ggplot2::labs(
title = "Gelman-Rubin R-hat as the chains grow (post burn-in)",
subtitle = "Should decrease to 1 and stay there | dashed blue: 1.01",
x = "Last iteration used",
y = "R-hat"
) +
diag_theme()
print(p)
invisible(p)
}
#' Posterior Correlation Matrix of the Hyperparameters (chains pooled)
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @return Rounded correlation matrix of the 5 hyperparameters
compute_hyper_correlations <- function(res) {
round(cor(as.matrix(get_hyper_mcmc(res))), 2)
}
#' Summarize Posterior Estimates vs Ground Truth (chains pooled)
#'
#' Also reports the derived physical quantities of modeling_choices_v2:
#' range rho = sqrt(8) / kappa and anisotropy ratio a = exp(||v||).
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @param sim_data Output list of the toy data generator
#' @param truth List of true values (kappa, sigma_beta, v1, v2, sigma_e)
#' @param vertex Vertex index used for beta_tilde and mu
#' @return Matrix with True, Mean, 2.5%, Median, and 97.5% quantiles
summarize_hyperparameters <- function(res, sim_data, truth, vertex = 1L) {
draws <- do.call(rbind, res$hyper)
true_anomaly <- get_true_anomaly(sim_data)
summ_vec <- function(x, true_val) {
q <- quantile(x, c(0.025, 0.5, 0.975))
c(True = true_val, Mean = mean(x), `2.5%` = q[[1]], Median = q[[2]], `97.5%` = q[[3]])
}
kappa <- draws[, "kappa"]
v_norm <- sqrt(draws[, "v1"]^2 + draws[, "v2"]^2)
est_tab <- rbind(
"sigma^2_e" = summ_vec(draws[, "sigma^2_e"], truth$sigma_e^2),
"kappa" = summ_vec(kappa, truth$kappa),
"sigma_beta" = summ_vec(draws[, "sigma_beta"], truth$sigma_beta),
"v1" = summ_vec(draws[, "v1"], truth$v1),
"v2" = summ_vec(draws[, "v2"], truth$v2),
"range sqrt(8)/kappa" = summ_vec(sqrt(8) / kappa, sqrt(8) / truth$kappa),
"aniso ratio exp(|v|)" = summ_vec(exp(v_norm), exp(sqrt(truth$v1^2 + truth$v2^2))),
"beta_tilde" = summ_vec(
res$beta_samples[vertex, 1, ] - res$mu_samples[vertex, ],
true_anomaly[vertex, 1]
),
"mu" = summ_vec(res$mu_samples[vertex, ], sim_data$mu_true[vertex])
)
rownames(est_tab)[8:9] <- c(sprintf("beta_tilde[%d,1]", vertex), sprintf("mu[%d]", vertex))
round(est_tab, 4)
}
#' Evaluate Field Reconstruction Accuracy vs Naive Baseline
#'
#' The posterior mean of the anomaly is evaluated at the observation locations
#' (through Phi) and compared with the true, noise-free anomaly there. The naive
#' baseline (each year minus the location's average over years) only exists at
#' the observation locations, so both are compared there. Vertices in the mesh
#' extension have no data and are left out by construction.
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @param sim_data Output list of the toy data generator (y_mat, beta_mat, mu_true, Phi)
#' @param anomaly Output of `summarize_anomaly(res)`
#' @param plot_results Logical; whether to plot the model and naive scatter plots
#' @return Data frame comparing Model vs Naive baseline metrics
evaluate_field_accuracy <- function(res, sim_data, anomaly, plot_results = TRUE) {
Phi <- sim_data$Phi
Y_mat <- sim_data$y_mat
metrics <- function(est, truth) {
err <- est - truth
c(
sqrt(mean(err^2)),
mean(abs(err)),
cor(as.vector(est), as.vector(truth))
)
}
true_obs <- as.matrix(Phi %*% get_true_anomaly(sim_data))
est_obs <- as.matrix(Phi %*% anomaly$mean)
naive_obs <- Y_mat - rowMeans(Y_mat)
if (plot_results) {
n_obs <- length(true_obs)
# Thin to at most 20000 points per panel for fast plotting (deterministic, no RNG)
keep <- unique(round(seq(1, n_obs, length.out = min(n_obs, 20000L))))
scatter_df <- rbind(
data.frame(method = "Model (posterior mean)", truth = true_obs[keep], estimate = est_obs[keep]),
data.frame(method = "Naive baseline", truth = true_obs[keep], estimate = naive_obs[keep])
)
lim <- range(scatter_df$truth, scatter_df$estimate)
p <- ggplot2::ggplot(scatter_df, ggplot2::aes(x = truth, y = estimate)) +
ggplot2::geom_point(alpha = 0.15, size = 0.4) +
ggplot2::geom_abline(slope = 1, intercept = 0, colour = "firebrick", linewidth = 0.8) +
ggplot2::facet_wrap(~method, ncol = 2) +
ggplot2::coord_equal(xlim = lim, ylim = lim) +
ggplot2::labs(
title = "Anomaly at the observation locations",
subtitle = "Red: estimate = truth",
x = "True anomaly",
y = "Estimate"
) +
diag_theme()
print(p)
}
data.frame(
Metric = c("RMSE", "MAE", "Correlation with truth"),
Model_obs = round(metrics(est_obs, true_obs), 4),
Naive_obs = round(metrics(naive_obs, true_obs), 4)
)
}
#' Plot 2x2 Spatial Maps of the Anomaly for a Selected Year (ggplot2)
#'
#' Vertex values are projected onto a regular grid with the P1 finite element
#' basis (as in `plot_spde_field()`). The maps cover the bounding box of the
#' observation locations (`sim_data$locs`), or the whole mesh if the data are at
#' the vertices: vertices in the mesh extension have no data, so their large
#' posterior sd would otherwise dominate the colour scales.
#' The true anomaly and the posterior mean share one colour scale (limits = range
#' of both maps), so their colours can be compared directly. The posterior sd
#' (sequential palette) and the error (diverging palette centred at 0) each have
#' their own scale. Requires the ggplot2 and patchwork packages.
#'
#' @param mesh fmesher 2D mesh object
#' @param sim_data Output list of the toy data generator
#' @param anomaly Output of `summarize_anomaly(res)`
#' @param year Integer index of year to display
#' @param resolution Number of grid points per axis
#' @return Invisibly returns the patchwork object (it is also printed)
plot_spatial_year_diagnostics <- function(
mesh,
sim_data,
anomaly,
year = 1L,
resolution = 150L
) {
true_vert <- get_true_anomaly(sim_data)
err <- anomaly$mean[, year] - true_vert[, year]
# Regular grid over the data area, projected with the P1 basis
area <- if (is.null(sim_data$locs)) mesh$loc else as.matrix(sim_data$locs)
grid <- expand.grid(
x = seq(min(area[, 1]), max(area[, 1]), length.out = resolution),
y = seq(min(area[, 2]), max(area[, 2]), length.out = resolution)
)
A <- fmesher::fm_basis(mesh, loc = as.matrix(grid))
inside <- Matrix::rowSums(A) > 0
grid <- grid[inside, ]
A <- A[inside, , drop = FALSE]
on_grid <- function(values) as.vector(A %*% values)
make_panel <- function(values, title, fill_scale) {
df <- grid
df$value <- on_grid(values)
ggplot2::ggplot(df, ggplot2::aes(x = x, y = y, fill = value)) +
ggplot2::geom_raster() +
ggplot2::coord_equal(expand = FALSE) +
fill_scale +
ggplot2::labs(title = title, x = NULL, y = NULL) +
diag_theme(base_size = 10) +
ggplot2::theme(
legend.position = "right",
legend.key.width = ggplot2::unit(0.3, "cm"),
legend.key.height = ggplot2::unit(0.55, "cm"),
legend.title = ggplot2::element_text(size = 9),
legend.text = ggplot2::element_text(size = 8),
plot.margin = ggplot2::margin(2, 4, 2, 4),
panel.grid = ggplot2::element_blank()
)
}
# Truth and posterior mean share one colour scale
shared_lim <- range(on_grid(true_vert[, year]), on_grid(anomaly$mean[, year]))
anomaly_scale <- function() {
ggplot2::scale_fill_distiller(
palette = "Spectral",
direction = -1,
limits = shared_lim,
name = "Anomaly"
)
}
err_max <- max(abs(on_grid(err)))
p_true <- make_panel(true_vert[, year], "True anomaly", anomaly_scale())
p_mean <- make_panel(anomaly$mean[, year], "Posterior mean", anomaly_scale())
p_sd <- make_panel(
anomaly$sd[, year],
"Posterior sd",
ggplot2::scale_fill_viridis_c(option = "magma", direction = -1, name = "sd")
)
p_err <- make_panel(
err,
"Error (mean - truth)",
ggplot2::scale_fill_distiller(
palette = "RdBu",
direction = -1,
limits = c(-err_max, err_max),
name = "Error"
)
)
# Top row: one shared legend for both maps; bottom row: one legend per map
top_row <- patchwork::wrap_plots(p_true, p_mean, ncol = 2, guides = "collect")
bottom_row <- patchwork::wrap_plots(p_sd, p_err, ncol = 2)
p <- patchwork::wrap_plots(top_row, bottom_row, ncol = 1) +
patchwork::plot_annotation(
title = sprintf("Anomaly field, year %d", year),
theme = ggplot2::theme(plot.title = ggplot2::element_text(face = "bold", size = 13))
)
print(p)
invisible(p)
}
#' Run Complete Diagnostic Suite and Print Summary Tables
#'
#' @param res Output of `cpp_fit_to_diagnostics()`
#' @param mesh fmesher 2D mesh object
#' @param sim_data Output list of the toy data generator
#' @param truth List of true values (kappa, sigma_beta, v1, v2, sigma_e)
#' @param num_burn_in Number of burn-in iterations
#' @param elapsed Optional elapsed time in seconds
#' @param year Year index for the spatial maps
#' @param vertex Vertex index for the beta_tilde and mu traces
#' @return Invisibly returns list of summary tables
run_all_diagnostics <- function(
res,
mesh,
sim_data,
truth,
num_burn_in,
elapsed = NULL,
year = 1L,
vertex = 1L
) {
cat("\n=== MCMC RUN SUMMARY ===\n")
if (!is.null(elapsed)) {
cat(sprintf("Elapsed Time: %.2f s\n", elapsed))
}
cat(sprintf(
"Acceptance Rate (post burn-in), by chain: %s\n\n",
paste(sprintf("%.1f%%", res$acceptance_rate * 100), collapse = " | ")
))
plot_mcmc_traces(res, sim_data, truth, num_burn_in, vertex = vertex)
ess_tab <- plot_mcmc_acf_ess(res, vertex = vertex)
cat("=== EFFECTIVE SAMPLE SIZE AND R-HAT (POST BURN-IN, ALL CHAINS) ===\n")
print(ess_tab, row.names = FALSE)
cat("\n")
plot_gelman_rubin(res, num_burn_in)
cor_mat <- compute_hyper_correlations(res)
cat("=== POSTERIOR CORRELATIONS ===\n")
print(cor_mat)
cat("\n")
est_tab <- summarize_hyperparameters(res, sim_data, truth, vertex = vertex)
cat("=== POSTERIOR ESTIMATES VS GROUND TRUTH ===\n")
print(est_tab)
cat("\n")
anomaly <- summarize_anomaly(res)
field_tab <- evaluate_field_accuracy(res, sim_data, anomaly, plot_results = TRUE)
cat("=== ANOMALY FIELD RECONSTRUCTION ACCURACY ===\n")
print(field_tab, row.names = FALSE)
mu_rmse <- sqrt(mean((rowMeans(res$mu_samples) - sim_data$mu_true)^2))
cat(sprintf("\nRMSE of posterior mean of mu (vertices): %.4f\n\n", mu_rmse))
plot_spatial_year_diagnostics(mesh, sim_data, anomaly, year = year)
invisible(list(
ess = ess_tab,
correlations = cor_mat,
estimates = est_tab,
field_metrics = field_tab,
mu_rmse = mu_rmse,
anomaly = anomaly
))
}
fit_diag <- cpp_fit_to_diagnostics(fit, Y_mat = Y_mat, Phi = Phi,
matrices = matrices, num_burn_in = num_burn_in)
diag_results <- run_all_diagnostics(res = fit_diag, mesh = mesh, sim_data = sim_data,
truth = truth, num_burn_in = num_burn_in,
elapsed = elapsed, year = 1L, vertex = 200L)

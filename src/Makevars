# Setting standard
CXX_STD = CXX14

# Include path
PKG_CPPFLAGS = -I../inst/include

# Compilation Flags
PKG_CXXFLAGS = -Wno-ignored-attributes

# Comopilation Rules
SOURCES = $(wildcard *.cpp) $(wildcard */*.cpp)
OBJECTS = $(SOURCES:.cpp=.o)

all: $(SHLIB)

clean:
	rm -f *.o *.so *.dll
	rm -f MatrixAssembler/*.o